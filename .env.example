SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-key"
VITE_SUPABASE_PROJECT_ID="your-supabase-project-id"

LOVABLE_API_KEY="your-lovable-ai-gateway-key"

# Core providers (at least one required)
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-1.5-flash"
OPENROUTER_FREE_API_KEY="your-openrouter-free-api-key"
OPENROUTER_FREE_MODEL="google/gemini-2.0-flash-exp:free"
GROQ_API_KEY="your-groq-api-key"
GROQ_MODEL="llama-3.3-70b-versatile"

# Local providers (optional, for Ollama or LM Studio)
# WARNING: Free-tier and local model IDs can change without notice.
# OLLAMA_BASE_URL defaults to http://localhost:11434/v1 (OpenAI-compatible mode)
OLLAMA_BASE_URL="http://localhost:11434/v1"
OLLAMA_MODEL="qwen2.5-coder:32b"
# LMSTUDIO_BASE_URL defaults to http://localhost:1234/v1 (OpenAI-compatible mode)
LMSTUDIO_BASE_URL="http://localhost:1234/v1"
LMSTUDIO_MODEL="google/gemini-2.0-flash-thinking"

# Additional API providers (optional, adapter-ready)
# Mistral uses OpenAI-compatible endpoint at https://api.mistral.ai/v1
MISTRAL_API_KEY="your-mistral-api-key"
MISTRAL_MODEL="mistral-large-latest"
# Cerebras uses OpenAI-compatible endpoint at https://api.cerebras.ai/v1
CEREBRAS_API_KEY="your-cerebras-api-key"
CEREBRAS_MODEL="llama-3.3-70b"

# Remaining providers (optional)
NVIDIA_NIM_API_KEY="your-nvidia-nim-api-key"
NVIDIA_NIM_MODEL="nvdev/nemotron-4-34b-reward"
CF_WORKERS_AI_TOKEN="your-cloudflare-workers-ai-token"
CF_WORKERS_AI_BASE_URL="https://api.cloudflare.com/client/v4/accounts/your-account-id/ai/v1"
CF_WORKERS_AI_MODEL="@cf/meta/llama-3.1-70b-instruct"
GITHUB_TOKEN="your-github-token"
GITHUB_MODELS_MODEL="o1-mini"
HF_API_KEY="your-huggingface-api-key"
HF_MODEL="deepseek-ai/DeepSeek-R1"
